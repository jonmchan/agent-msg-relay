---
const slides = [
	{
		name: 'Task board',
		text: "Listen for tasks from other agents. Add each one to this agent's task list.",
	},
	{
		name: 'Handoff',
		text: 'When the plan is ready, send it as a task to the agent that will build it.',
	},
	{
		name: 'Code review',
		text: 'Listen for reviews from other agents. Send the notes back when the review is done.',
	},
	{
		name: 'Errands',
		text: 'Receive errands from other agents, and send the result back when the errand is done.',
	},
	{
		name: 'Keep watch',
		text: 'When you notice work the build agent should do, send it as a task.',
	},
	{
		name: 'Chief of staff',
		text: 'When the inbox has something the analysis agent should know, send it a brief.',
	},
	{
		name: 'News brief',
		text: 'Send a summary once a day to #news.',
	},
	{
		name: 'Tracker',
		text: 'Post a status to #tracker when the state of the work changes.',
	},
];
---

<section class="prompts" aria-roledescription="carousel" aria-label="Example prompts">
	<h2>Example prompts</h2>
	<p>Each slide is a use case, then the prompt to paste.</p>
	<div class="prompt-carousel" data-prompt-carousel>
		<div class="prompt-stage">
			<button class="prompt-arrow prompt-prev" type="button" data-prompt-prev aria-label="Previous prompt">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 6.5 9 12l5.5 5.5" /></svg>
			</button>
			<button class="prompt-arrow prompt-next" type="button" data-prompt-next aria-label="Next prompt">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 6.5 5.5 5.5-5.5 5.5" /></svg>
			</button>
			<div class="prompt-body">
				<div class="prompt-viewport">
					<div class="prompt-track" data-prompt-track>
						{
							slides.map((slide, index) => (
								<div class="prompt-slide" data-prompt-slide aria-hidden={index === 0 ? 'false' : 'true'}>
									<span class="prompt-kicker">{slide.name}</span>
									<pre><code>{slide.text}</code></pre>
								</div>
							))
						}
					</div>
				</div>
				<button class="prompt-copy" type="button" data-prompt-copy>Copy</button>
			</div>
		</div>
		<div class="dots">
			{
				slides.map((slide, index) => (
					<button
						type="button"
						data-prompt-dot={index}
						aria-label={slide.name}
						aria-current={index === 0 ? 'true' : 'false'}
					/>
				))
			}
		</div>
	</div>
</section>

<script is:inline define:vars={{ slides }}>
	const root = document.currentScript.previousElementSibling.querySelector('[data-prompt-carousel]');
	const track = root.querySelector('[data-prompt-track]');
	const slideEls = [...root.querySelectorAll('[data-prompt-slide]')];
	const copy = root.querySelector('[data-prompt-copy]');
	const dots = [...root.querySelectorAll('[data-prompt-dot]')];
	const autoplayTime = 3000;
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	let index = 0;
	let progress = 0;
	let hovered = false;
	let focused = false;
	let timer = 0;

	function paused() {
		return reduceMotion || hovered || focused;
	}

	function goTo(next) {
		index = (next % slides.length + slides.length) % slides.length;
		track.style.transform = 'translate3d(' + -index * 100 + '%, 0, 0)';
		slideEls.forEach((slide, i) => {
			slide.setAttribute('aria-hidden', i === index ? 'false' : 'true');
		});
		dots.forEach((dot, i) => {
			const on = i === index;
			dot.setAttribute('aria-current', on ? 'true' : 'false');
			if (!on) dot.style.removeProperty('--progress');
		});
		progress = 0;
		dots[index].style.setProperty('--progress', '0%');
		copy.textContent = 'Copy';
	}

	function tick() {
		if (paused()) return;
		progress += 100 / (autoplayTime / 20);
		dots[index].style.setProperty('--progress', Math.min(progress, 100) + '%');
		if (progress >= 100) goTo(index + 1);
	}

	function start() {
		window.clearInterval(timer);
		if (reduceMotion) return;
		timer = window.setInterval(tick, 20);
	}

	root.querySelector('[data-prompt-prev]').addEventListener('click', () => goTo(index - 1));
	root.querySelector('[data-prompt-next]').addEventListener('click', () => goTo(index + 1));
	for (const dot of dots) {
		dot.addEventListener('click', () => goTo(Number(dot.dataset.promptDot)));
	}
	root.addEventListener('keydown', (event) => {
		if (event.key === 'ArrowRight') {
			event.preventDefault();
			goTo(index + 1);
		} else if (event.key === 'ArrowLeft') {
			event.preventDefault();
			goTo(index - 1);
		}
	});
	root.addEventListener('mouseenter', () => {
		hovered = true;
	});
	root.addEventListener('mouseleave', () => {
		hovered = false;
	});
	root.addEventListener('focusin', () => {
		focused = true;
	});
	root.addEventListener('focusout', (event) => {
		if (!root.contains(event.relatedTarget)) focused = false;
	});
	copy.addEventListener('click', async () => {
		try {
			await navigator.clipboard.writeText(slides[index].text);
			copy.textContent = 'Copied';
		} catch {
			copy.textContent = 'Copy failed';
		}
	});
	start();
</script>
